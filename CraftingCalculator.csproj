<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.2</Version>
    <ApplicationIcon>assets/forge.ico</ApplicationIcon>
    <ReleaseRepository Condition="'$(ReleaseRepository)' == ''">NekoMisa/archeage-chronicles-crafting</ReleaseRepository>
  </PropertyGroup>
  <ItemGroup>
    <None Update="recipes.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <AssemblyMetadata Include="ReleaseRepository" Value="$(ReleaseRepository)" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
</Project>
